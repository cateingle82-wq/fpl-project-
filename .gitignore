# Python
__pycache__/
*.pyc

# OS clutter
.DS_Store

# Personal notes, not part of the project
sticky-notes/

# Large / regenerable data — these are all rebuilt by running the scripts,
# so there's no point bloating git history with them (some are multi-MB).
history_cache/
feature_cache.joblib
player_history_cache.json
fpl_snapshot.csv

# The trained model is a binary blob that regenerates from ml_train.py —
# convenient to keep locally, not worth tracking in git (every retrain
# would show as a full-file change with no readable diff).
ml_model.joblib

# Per-machine "last run" state for the dashboard's diff-vs-last-run
# feature — regenerates on the next run, and its whole point is to be
# THIS machine's most recent run, not a synced/shared value.
last_run_snapshot.json

# Keep: all your .py files, test_*.py, the small result CSVs
# (backtest_results.csv, chip_log.csv, ml_holdout_results.csv) — those are
# small and genuinely useful to see change over time in git history.
